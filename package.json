{
  "name": "control-parental-relay",
  "version": "0.0.1",
  "private": true,
  "description": "Servidor independiente CP/1; desarrollo local sin tráfico público",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test:esquema": "node scripts/verificar-esquema.mjs",
    "verificar": "node scripts/verificar.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
