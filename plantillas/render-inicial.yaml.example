services:
  - type: web
    name: parental-relay
    runtime: node
    numInstances: 1
    autoDeployTrigger: "off"
    buildCommand: corepack pnpm install --frozen-lockfile --prod=false && corepack pnpm run build
    startCommand: corepack pnpm start
    healthCheckPath: /keepalive
    envVars:
      - key: NODE_ENV
        value: production
      - key: LOG_LEVEL
        value: error
      - key: RELAY_MODE
        value: bootstrap
      # Después de obtener la URL real, SELF_URL activa la autollamada opcional.
      # Sin SELF_URL no hay autollamadas; intervalo por defecto: 600000ms.
